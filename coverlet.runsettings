<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>

          <!--
          <Exclude>
            [HttpPostNewExperiment]*
          </Exclude>
          -->

          <!--
          <ModulePathsExclude>
            <exclude>.*HttpPostNewExperiment.*</exclude>
          </ModulePathsExclude>
          <SourceFileExclude>
            <exclude>.*HttpPostNewExperiment.*</exclude>
          </SourceFileExclude>
          -->

          <!-- Exclude files by attribute -->
          <!--
          <ExcludeByFile>
            <file>**/HttpPostNewTriggerTests.cs</file>
            <file>**/HttpPostNewExperiment.cs</file>
            <file>**/add-functions/HttpPostNewExperiment/**/*.cs</file>
          </ExcludeByFile>
          -->

          <ExcludeByFile>
            <file>**/add-functions/HttpPostNewExperiment/**</file>
          </ExcludeByFile>


          <!-- Exclude attributes (methods/classes marked with these) -->
          <ExcludeByAttribute>
            <attribute>System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute</attribute>
            <attribute>System.ObsoleteAttribute</attribute>
            <attribute>System.Diagnostics.DebuggerNonUserCodeAttribute</attribute>
          </ExcludeByAttribute>
          
          <!-- Exclude files by attribute -->
          <ExcludeByFile>
            <file>**/Migrations/**/*.cs</file>
            <file>**/*Designer.cs</file>
            <file>**/*.Generated.cs</file>
            <file>**/HttpPostNewTriggerTests.cs</file>
          </ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>